{
  "name": "lucy-dashboard",
  "private": true,
  "type": "module",
  "description": "Lucy's dashboard: built into dist/, which the server embeds",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test \"src/**/*.test.ts\"",
    "verify-dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
